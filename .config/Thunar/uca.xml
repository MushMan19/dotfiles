<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1759786102959957-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>com.github.philip-scott.wallpaperize</icon>
	<name>Use as Theme</name>
	<submenu></submenu>
	<unique-id>1767102981575991-1</unique-id>
	<command>theme-switch generate -i %f -n %n &amp;&amp; theme-switch apply -n %n</command>
	<description>Use as the wallpaper and set the desktop theme to match this background</description>
	<range>*</range>
	<patterns>*</patterns>
	<startup-notify/>
	<image-files/>
