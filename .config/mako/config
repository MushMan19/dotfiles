# ======================================
# Global (Matches swayosd appearance)
# ======================================

# Colors
background-color=#0b1027cc     # 80% alpha like swayosd (0.7–0.8 range)
text-color=#ced7f2
border-color=#ced7f2
progress-color=over #ced7f2     # matches the filled progress in swayosd

# Layout
font=JetBrainsMono Nerd Font 11
border-size=2                  # swayosd uses 2px
corner-radius=5                # identical to swayosd
padding=10
width=340
height=110
margin=20
icons=1
max-icon-size=48

# Behavior
markup=1
default-timeout=5000
anchor=top-right
layer=overlay
max-visible=5

# ======================================
# Normal notifications 
# (Main cohesive look equivalent to swayosd)
# ======================================
[urgency=normal]
background-color=#0b1027cc
border-color=#ced7f2
text-color=#ced7f2
progress-color=over #ced7f2

# ======================================
# Low urgency 
# (Same look but softer border)
# ======================================
[urgency=low]
background-color=#0b1027cc
border-color=#9da9d8       # slightly softer icy blue
text-color=#ced7f2
progress-color=over #9da9d8

# ======================================
# High urgency 
# (Keep cohesive look but add polite highlight)
# ======================================
[urgency=high]
background-color=#0b1027cc
border-color=#eaaecf       # soft pinkish warning (fits your palette)
text-color=#fdf7ff         # slightly brighter for visibility
progress-color=over #eaaecf
default-timeout=10000
